# ===== PROJECT SPECIFIC =====
# Video storage - exclude all videos but keep directory structure
videos/*
!videos/.gitkeep

# Processed data - exclude all processed files but keep directory structure
processed/
!processed/.gitkeep
processed/transcriptions/
!processed/transcriptions/.gitkeep
processed/embeddings/
!processed/embeddings/.gitkeep
processed/indices/
!processed/indices/.gitkeep

# Legacy directories
transcripts/*
!transcripts/.gitkeep
index/*
!index/.gitkeep

# Debug and temp files
